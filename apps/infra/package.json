{
  "name": "@paraprosdokian-htf/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Deployable CDK app that composes the @paraprosdokian-htf/* construct packages into the ParaprosdokianHtfStack.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
