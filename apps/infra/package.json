    "typecheck": "tsc -b && tsc -p test"
  },
  "dependencies": {
    "@paraprosdokian-htf/ecr": "*",
    "@paraprosdokian-htf/eks-cluster": "*",
    "@paraprosdokian-htf/network": "*",
    "@paraprosdokian-htf/workloads": "*",
    "aws-cdk-lib": "^2.239.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1147.0"
  }
}
