{
  "name": "paraprosdokian-htf",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the paraprosdokian-htf EKS platform (CDK construct packages + deployable app).",
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "tsc -b --clean",
    "test": "npm run typecheck && jest",
    "cdk": "npm run cdk --workspace @paraprosdokian-htf/infra --",
    "synth": "npm run cdk -- synth",
    "diff": "npm run cdk -- diff",
    "deploy": "npm run cdk -- deploy",
    "typecheck": "tsc -b && npm run typecheck --workspaces --silent"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  }
}
